# apps/api/.env
DATABASE_URL="postgresql://apsaas:apsaas@localhost:5432/apsaas?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="900"
PORT=4000
WEB_ORIGIN="http://localhost:5173"

# ---------------------------------------------------------------------------
# DEV MASTER CREDENTIALS
# Used ONLY by the seeder and local development login. Never commit real values.
# These must match the user seeded by prisma/seed.ts for local dev.
# ---------------------------------------------------------------------------
DEV_MASTER_EMAIL="dev@avarta.local"
DEV_MASTER_PASSWORD="change-me-dev-only"

# ---------------------------------------------------------------------------
# BYOPG — Bring Your Own Payment Gateway
# Tenants configure their own payment rail via Settings → Payment Gateway.
# The API reads the org's encrypted gateway config from the integrations table.
# The vars below are the Avarta platform-level fallback for dev/testing only.
# ---------------------------------------------------------------------------
# Razorpay (default dev test mode)
PAYMENT_GATEWAY_DEFAULT="RAZORPAY"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Cashfree
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
# PayU
PAYU_MERCHANT_KEY=""
PAYU_MERCHANT_SALT=""
# Direct NEFT/RTGS via Bank API
BANK_API_URL=""
BANK_API_CLIENT_ID=""
BANK_API_CLIENT_SECRET=""

# apps/web/.env
VITE_API_URL="http://localhost:4000/api/v1"
