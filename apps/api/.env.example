# =============================================================================
# AVARTA AP WORKSPACE — API ENVIRONMENT CONFIGURATION
# =============================================================================

# Server Port
PORT=4000
NODE_ENV=development

# -----------------------------------------------------------------------------
# DATABASE CONNECTIONS (PostgreSQL / Neon)
# -----------------------------------------------------------------------------
# DATABASE_URL:
# Runtime pooled connection. For Neon, use the pooled endpoint (-pooler) with:
# ?sslmode=require&pgbouncer=true&connection_limit=10
DATABASE_URL="postgresql://postgres:123456@127.0.0.1:5432/avarta_db?schema=public"

# DIRECT_URL:
# Direct unpooled connection. Required in production for `prisma migrate deploy`
# because PgBouncer transaction mode does not support session advisory locks.
DIRECT_URL="postgresql://postgres:123456@127.0.0.1:5432/avarta_db?schema=public"

# -----------------------------------------------------------------------------
# SECURITY & CRYPTOGRAPHY
# -----------------------------------------------------------------------------
# JWT_SECRET:
# Secret key used for signing session tokens (HMAC-SHA256).
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="900"

# APP_ENCRYPTION_KEY:
# Dedicated master encryption key for AES-256-GCM encryption of tracking tokens
# and integration credentials. Must be either:
# 1) A 64-character hex string (recommended):
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 2) Exactly 32 raw bytes.
# CRITICAL: Store in secret manager; backup securely. Never rotate casually!
APP_ENCRYPTION_KEY="avarta-dev-encryption-key-32chars!!"

# Web Origin (CORS & Public Tracking Link redirects)
WEB_ORIGIN="http://localhost:5173"

# -----------------------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY (STRICTLY FORBIDDEN IN PRODUCTION)
# -----------------------------------------------------------------------------
# These credentials are automatically rejected if NODE_ENV=production.
MASTER_DEV_EMAIL="dev@avarta.local"
MASTER_DEV_PASSWORD="devpassword123"
